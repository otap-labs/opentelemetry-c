# SPDX-License-Identifier: Apache-2.0

@PACKAGE_INIT@

# OpenTelemetryC CMake package configuration.
# Installed by: opentelemetry-c @OTEL_C_VERSION@
#
# Usage:
#   find_package(OpenTelemetryC CONFIG REQUIRED)
#   target_link_libraries(my_lib PRIVATE OpenTelemetryC::api)
#   target_link_libraries(my_app PRIVATE OpenTelemetryC::sdk)
#
# IMPORTANT: API and SDK from different package versions must NOT be mixed.
# This package is pre-1.0; different 0.x minor versions are incompatible.

set(_OTEL_C_VERSION "@OTEL_C_VERSION@")

# Locate libraries and headers using PATH_VARS-generated variables.
# These paths are relative to the actual install prefix at find_package time,
# so the package remains functional after prefix relocation.
set_and_check(_otelc_lib_dir     "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set_and_check(_otelc_include_dir "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Determine platform suffix
if(WIN32)
    if(NOT MSVC)
        message(FATAL_ERROR
            "OpenTelemetryC: experimental Windows packages require the MSVC toolchain")
    endif()
    set_and_check(_otelc_bin_dir "@PACKAGE_CMAKE_INSTALL_BINDIR@")
    set(_otelc_lib_prefix "")
    set(_otelc_lib_suffix ".dll")
    set(_otelc_import_suffix ".dll.lib")
    set(_otelc_runtime_dir "${_otelc_bin_dir}")
elseif(APPLE)
    set(_otelc_lib_prefix "lib")
    set(_otelc_lib_suffix ".dylib")
elseif(UNIX)
    set(_otelc_lib_prefix "lib")
    set(_otelc_lib_suffix ".so")
else()
    message(FATAL_ERROR "OpenTelemetryC: unsupported shared-library platform.")
endif()

if(WIN32)
    set(_otelc_api_lib "${_otelc_runtime_dir}/opentelemetry_c_api${_otelc_lib_suffix}")
    set(_otelc_sdk_lib "${_otelc_runtime_dir}/opentelemetry_c_sdk${_otelc_lib_suffix}")
else()
    set(_otelc_api_lib "${_otelc_lib_dir}/${_otelc_lib_prefix}opentelemetry_c_api${_otelc_lib_suffix}")
    set(_otelc_sdk_lib "${_otelc_lib_dir}/${_otelc_lib_prefix}opentelemetry_c_sdk${_otelc_lib_suffix}")
endif()

# Validate that the libraries exist at the resolved location
if(NOT EXISTS "${_otelc_api_lib}")
    set(OpenTelemetryC_FOUND FALSE)
    set(OpenTelemetryC_NOT_FOUND_MESSAGE
        "OpenTelemetryC: API library not found at '${_otelc_api_lib}'")
    return()
endif()
if(NOT EXISTS "${_otelc_sdk_lib}")
    set(OpenTelemetryC_FOUND FALSE)
    set(OpenTelemetryC_NOT_FOUND_MESSAGE
        "OpenTelemetryC: SDK library not found at '${_otelc_sdk_lib}'")
    return()
endif()
if(NOT EXISTS "${_otelc_include_dir}")
    set(OpenTelemetryC_FOUND FALSE)
    set(OpenTelemetryC_NOT_FOUND_MESSAGE
        "OpenTelemetryC: include directory not found at '${_otelc_include_dir}'")
    return()
endif()

# ── OpenTelemetryC::api ───────────────────────────────────────────────────────
if(NOT TARGET OpenTelemetryC::api)
    add_library(OpenTelemetryC::api SHARED IMPORTED)
    set_target_properties(OpenTelemetryC::api PROPERTIES
        IMPORTED_LOCATION "${_otelc_api_lib}"
        INTERFACE_INCLUDE_DIRECTORIES "${_otelc_include_dir}"
    )
    if(WIN32)
        set_target_properties(OpenTelemetryC::api PROPERTIES
            IMPORTED_IMPLIB "${_otelc_lib_dir}/opentelemetry_c_api${_otelc_import_suffix}")
    endif()
endif()

# ── OpenTelemetryC::sdk ───────────────────────────────────────────────────────
if(NOT TARGET OpenTelemetryC::sdk)
    add_library(OpenTelemetryC::sdk SHARED IMPORTED)
    set_target_properties(OpenTelemetryC::sdk PROPERTIES
        IMPORTED_LOCATION "${_otelc_sdk_lib}"
        INTERFACE_INCLUDE_DIRECTORIES "${_otelc_include_dir}"
        INTERFACE_LINK_LIBRARIES "OpenTelemetryC::api"
    )
    if(WIN32)
        set_target_properties(OpenTelemetryC::sdk PROPERTIES
            IMPORTED_IMPLIB "${_otelc_lib_dir}/opentelemetry_c_sdk${_otelc_import_suffix}")
    endif()
endif()

set(OpenTelemetryC_FOUND TRUE)
set(OpenTelemetryC_VERSION "${_OTEL_C_VERSION}")
