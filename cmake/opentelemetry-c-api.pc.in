# ${pcfiledir} is the directory containing this .pc file (<prefix>/@CMAKE_INSTALL_LIBDIR@/pkgconfig).
# Going up two levels gives the install prefix, making this file relocatable.
prefix=${pcfiledir}/../..
libdir=${pcfiledir}/..
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: opentelemetry-c-api
Description: OpenTelemetry C API (trace, metrics, logs instrumentation interface)
Version: @OTEL_C_VERSION@
Libs: -L${libdir} -lopentelemetry_c_api
Cflags: -I${includedir}
