prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: opentelemetry-c-sdk
Description: OpenTelemetry C SDK (OTLP exporter, metrics, logs backends)
Version: @OTEL_C_VERSION@
Requires: opentelemetry-c-api = @OTEL_C_VERSION@
Libs: -L${libdir} -lopentelemetry_c_sdk
Cflags: -I${includedir}
